require_once 'conexion.php';

// Obtener y Limpiar Filtros
$busqueda = $_GET['busqueda'] ?? '';
$filtro_estado = $_GET['estado'] ?? ''; 
$filtro_anio_detencion = $_GET['anio_detencion'] ?? '';
$filtro_anio_condena = $_GET['anio_condena'] ?? '';
$filtro_anio_registro = $_GET['anio_registro'] ?? ''; 

// Consulta base
$sql = "SELECT p.documento_identidad, p.nombre, p.apellido, p.fecha_detencion, p.fecha_registro,
            c.nombre AS nombre_centro, 
            a.nombre_area AS nombre_area,
            cj.numero_expediente, 
            cj.fecha_condena, 
            cj.duracion_condena_dias
        FROM privados p
        LEFT JOIN centros c ON p.centro_codigo = c.codigo
        LEFT JOIN areas_socioproductivas a ON p.area_codigo = a.codigo
        LEFT JOIN privados_casos pc ON p.documento_identidad = pc.privado_documento
        LEFT JOIN casos_judiciales cj ON pc.caso_expediente = cj.numero_expediente";

$condiciones = []; 

// Limpiar variables
$busqueda_limpia = $conexion->real_escape_string($busqueda);
$anio_detencion_limpio = $conexion->real_escape_string($filtro_anio_detencion);
$anio_condena_limpio = $conexion->real_escape_string($filtro_anio_condena);
$anio_registro_limpio = $conexion->real_escape_string($filtro_anio_registro);

// 2. Aplicar Filtros
if (!empty($busqueda)) {
    $condiciones[] = "(p.documento_identidad LIKE '%$busqueda_limpia%' 
            OR p.nombre LIKE '%$busqueda_limpia%' 
            OR p.apellido LIKE '%$busqueda_limpia%'
            OR cj.numero_expediente LIKE '%$busqueda_limpia%'
            OR c.nombre LIKE '%$busqueda_limpia%'
            OR a.nombre_area LIKE '%$busqueda_limpia%'
            OR p.fecha_detencion LIKE '%$busqueda_limpia%')";
}
if (!empty($filtro_anio_detencion)) {
    $condiciones[] = "YEAR(p.fecha_detencion) = '$anio_detencion_limpio'";
}
if (!empty($filtro_anio_condena)) {
    $condiciones[] = "YEAR(cj.fecha_condena) = '$anio_condena_limpio'";
}
if (!empty($filtro_anio_registro)) {
    $condiciones[] = "YEAR(p.fecha_registro) = '$anio_registro_limpio'"; 
}
if ($filtro_estado === 'candidato') {
    $condiciones[] = "(p.fecha_detencion IS NOT NULL AND cj.duracion_condena_dias > 0 AND cj.numero_expediente IS NOT NULL AND p.centro_codigo IS NOT NULL AND DATEDIFF(NOW(), p.fecha_detencion) >= (cj.duracion_condena_dias / 2))";
} elseif ($filtro_estado === 'incompleto') {
    $condiciones[] = "(p.fecha_detencion IS NULL OR cj.duracion_condena_dias IS NULL OR cj.duracion_condena_dias = 0 OR cj.numero_expediente IS NULL OR p.centro_codigo IS NULL)";
} elseif ($filtro_estado === 'regular') {
    $condiciones[] = "(p.fecha_detencion IS NOT NULL AND cj.duracion_condena_dias > 0 AND cj.numero_expediente IS NOT NULL AND p.centro_codigo IS NOT NULL AND DATEDIFF(NOW(), p.fecha_detencion) < (cj.duracion_condena_dias / 2))";
}

if (count($condiciones) > 0) {
    $sql .= " WHERE " . implode(' AND ', $condiciones);
}

$sql .= " ORDER BY p.apellido, p.nombre";

$resultado = $conexion->query($sql);
$total_registros_filtrados = $resultado->num_rows; 

if ($resultado === false) {
    die("Error en la consulta SQL: " . $conexion->error);
}

